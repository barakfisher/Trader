# =============================================================================
# Traders - environment template. Copy to .env and fill in.
# Every value below is read by exactly one typed config module
# (services/ai/app/config.py or apps/orchestrator/src/config.ts) and validated
# at boot: a missing required key fails startup loudly instead of at runtime.
# =============================================================================

# --- Core ---------------------------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=info                      # debug | info | warn | error
BASE_CURRENCY=USD
APP_TIMEZONE=Asia/Jerusalem         # drives market-hours and digest scheduling

# --- Auth (single-user v1) ----------------------------------------------------
# Passphrase used to sign in to the web UI.
APP_PASSPHRASE=change-me-in-your-local-env
# 32+ random bytes; signs the session cookie and (later) Telegram callbacks.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Datastores ---------------------------------------------------------------
POSTGRES_USER=traders
POSTGRES_PASSWORD=traders
POSTGRES_DB=traders
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side ports for the compose stack. Change these if another project on your
# machine already binds the defaults; the in-container ports never change.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
WEB_HOST_PORT=5173
AI_SERVICE_HOST_PORT=8000
ORCHESTRATOR_HOST_PORT=8080
DATABASE_URL=postgresql://traders:traders@postgres:5432/traders
REDIS_URL=redis://redis:6379/0

# --- Service wiring -----------------------------------------------------------
ORCHESTRATOR_PORT=8080
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
# Shared secret required on /internal/* routes (cron triggers, service-to-service).
INTERNAL_API_KEY=change-me-internal
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# --- Market data providers ----------------------------------------------------
# Ordered fallback chain. "fixture" needs no network or API key and is what CI
# and the demo portfolio use. See DESIGN.md section 4.
MARKET_DATA_PROVIDERS=fixture,yfinance
# Optional premium providers (unused until keys are present).
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# Cache TTLs in seconds.
# CACHE_TTL_QUOTE is a floor, not the TTL: a quote is cached for at least this
# long, and longer when the data cannot have changed - the serving provider's
# delay during US market hours (yfinance publishes every 15 minutes), one hour
# while the market is closed. Crypto is always 60s. See
# services/ai/app/core/cache_policy.py.
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=43200
CACHE_TTL_NEWS=900

# Per-provider daily request budgets, "provider=requests_per_day". Free tiers are
# capped per day as well as per minute (Alpha Vantage: 25/day), and a per-minute
# limiter cannot protect a daily cap. A provider over budget is skipped and the
# chain falls through to the next one. Empty means no daily cap.
# Self-imposed daily ceilings, "provider=calls". Yahoo publishes no quota and
# throttles bursts instead, so the ceiling exists to make a runaway loop
# degrade into a log line rather than a blocked IP. Roughly 3x what heavy daily
# use of a 20-symbol portfolio costs after the TTL policy above.
PROVIDER_DAILY_LIMITS=yfinance=2000

# --- News providers (Milestone 2) ---------------------------------------------
NEWS_PROVIDERS=fixture
NEWSAPI_KEY=
SERPER_API_KEY=

# --- LLM provider factory (Milestone 2+) --------------------------------------
# Which adapter to use: openrouter | openai | ollama | null. A value that cannot
# work - an unknown name, a missing key, or `anthropic`, whose native API has no
# adapter yet - degrades to no narration and logs why, rather than failing the
# service at boot. Anthropic models are reachable through OpenRouter today.
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_TEMPERATURE=0.1
# Hard daily spend ceiling in USD, enforced in code (services/ai/app/llm/budget.py)
# against estimated spend per UTC day. On breach the pipeline degrades to
# rule-based observations without LLM narration. 0 means no paid calls at all -
# unlike PROVIDER_DAILY_LIMITS above, it does not mean "unlimited".
LLM_DAILY_BUDGET_USD=5
# Per-call ceilings. A narration is a headline plus a short explanation, so a
# small output cap bounds both run latency and the cost of a verbose model.
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=30
# Token prices in USD per million tokens, "model=input/output", comma-separated,
# layered over the documented defaults in services/ai/app/llm/pricing.py. Spend is
# an ESTIMATE computed from this table: no OpenAI-compatible endpoint returns a
# billed amount, and OpenRouter charges its own rate per route. Override an entry
# when a vendor reprices; a release should not be needed for that.
# Example: LLM_MODEL_PRICES=anthropic/claude-sonnet-4.5=3/15,openai/gpt-4o-mini=0.15/0.60
LLM_MODEL_PRICES=
# Assumed price for a model absent from the table. Deliberately pessimistic: an
# unpriced model must not be counted as free, or the daily cap never fills.
LLM_UNKNOWN_MODEL_PRICE_USD_PER_MTOK=20

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# No adapter reads this yet; see LLM_PROVIDER above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama's root URL - the adapter appends the /v1 OpenAI-compatible prefix.
# host.docker.internal reaches the host's Ollama from inside a container; use
# http://localhost:11434 when running the service natively.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Local runtimes serve the models they have pulled, not the cloud model ids, so
# switching LLM_PROVIDER to ollama does not also mean editing LLM_MODEL.
OLLAMA_MODEL=llama3.2

# Embeddings (Milestone 3).
EMBEDDINGS_PROVIDER=fastembed       # fastembed (local, no key) | openai
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DIM=384

# --- Telegram (Milestone 4) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Observability ------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=traders
