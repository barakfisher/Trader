# =============================================================================
# Traders - environment template. Copy to .env and fill in.
# Every value below is read by exactly one typed config module
# (services/ai/app/config.py or apps/orchestrator/src/config.ts) and validated
# at boot: a missing required key fails startup loudly instead of at runtime.
# =============================================================================

# --- Core ---------------------------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=info                      # debug | info | warn | error
BASE_CURRENCY=USD
APP_TIMEZONE=Asia/Jerusalem         # drives market-hours and digest scheduling

# --- Auth (single-user v1) ----------------------------------------------------
# Passphrase used to sign in to the web UI.
APP_PASSPHRASE=change-me-in-your-local-env
# 32+ random bytes; signs the session cookie and (later) Telegram callbacks.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Datastores ---------------------------------------------------------------
POSTGRES_USER=traders
POSTGRES_PASSWORD=traders
POSTGRES_DB=traders
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side ports for the compose stack. Change these if another project on your
# machine already binds the defaults; the in-container ports never change.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
WEB_HOST_PORT=5173
AI_SERVICE_HOST_PORT=8000
ORCHESTRATOR_HOST_PORT=8080
DATABASE_URL=postgresql://traders:traders@postgres:5432/traders
REDIS_URL=redis://redis:6379/0

# --- Service wiring -----------------------------------------------------------
ORCHESTRATOR_PORT=8080
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
# Shared secret required on /internal/* routes (cron triggers, service-to-service).
INTERNAL_API_KEY=change-me-internal
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# --- Market data providers ----------------------------------------------------
# Ordered fallback chain. "fixture" needs no network or API key and is what CI
# and the demo portfolio use. See DESIGN.md section 4.
# Put yfinance first for real (15-minute delayed) prices and real daily history;
# keep fixture first to run entirely offline, which is what CI does.
MARKET_DATA_PROVIDERS=fixture,yfinance
# Optional premium providers (unused until keys are present).
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# Cache TTLs in seconds.
# CACHE_TTL_QUOTE is a floor, not the TTL: a quote is cached for at least this
# long, and longer when the data cannot have changed - the serving provider's
# delay during US market hours (yfinance publishes every 15 minutes), one hour
# while the market is closed. Crypto is always 60s. See
# services/ai/app/core/cache_policy.py.
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=43200
CACHE_TTL_NEWS=900

# Per-provider daily request budgets, "provider=requests_per_day". Free tiers are
# capped per day as well as per minute (Alpha Vantage: 25/day), and a per-minute
# limiter cannot protect a daily cap. A provider over budget is skipped and the
# chain falls through to the next one. Empty means no daily cap.
# Self-imposed daily ceilings, "provider=calls". Yahoo publishes no quota and
# throttles bursts instead, so the ceiling exists to make a runaway loop
# degrade into a log line rather than a blocked IP. Roughly 3x what heavy daily
# use of a 20-symbol portfolio costs after the TTL policy above.
PROVIDER_DAILY_LIMITS=yfinance=2000

# --- Analysis rule layer (Milestone 2) ----------------------------------------
# The deterministic rules in services/ai/app/analysis. Fractions, not percents:
# 0.03 is 3%. Each rule has three ascending bands - the first is the threshold
# below which nothing is emitted at all, the other two are where a finding is
# rated "notable" and "high". Severity is derived from these numbers and never
# chosen by a model.
ANALYSIS_PRICE_MOVE_PCT=0.03
ANALYSIS_PRICE_MOVE_NOTABLE_PCT=0.05
ANALYSIS_PRICE_MOVE_HIGH_PCT=0.08

# Sigma move: today's return divided by the trailing standard deviation of daily
# returns, which is what separates a 3% day in a utility from a 3% day in a
# miner. MIN_MOVE_PCT stops a near-flat instrument reporting a 0.3% wiggle as a
# 4-sigma event; STDEV_FLOOR stops a near-flat history becoming a tiny
# denominator (a finding whose z-score needed the floor is capped at "notable").
ANALYSIS_SIGMA_Z=2.0
ANALYSIS_SIGMA_NOTABLE_Z=3.0
ANALYSIS_SIGMA_HIGH_Z=4.0
ANALYSIS_SIGMA_WINDOW_DAYS=30
ANALYSIS_SIGMA_MIN_OBSERVATIONS=10
ANALYSIS_SIGMA_MIN_MOVE_PCT=0.01
ANALYSIS_SIGMA_STDEV_FLOOR=0.0025

# Drawdown from the trailing high within the window (a local high, not all-time).
ANALYSIS_DRAWDOWN_PCT=0.10
ANALYSIS_DRAWDOWN_NOTABLE_PCT=0.15
ANALYSIS_DRAWDOWN_HIGH_PCT=0.25
ANALYSIS_DRAWDOWN_WINDOW_DAYS=30
ANALYSIS_DRAWDOWN_MIN_OBSERVATIONS=5

# Allocation drift, in portfolio weight: 0.05 is five percentage points away
# from the target weight, not 5% of it.
ANALYSIS_DRIFT_PCT=0.05
ANALYSIS_DRIFT_NOTABLE_PCT=0.10
ANALYSIS_DRIFT_HIGH_PCT=0.15

# Widest gap in calendar days that two consecutive observations may span and
# still be called a one-day move. Weekends and holidays are normal; a symbol
# that stopped being priced for a fortnight is not, and gets no daily-move
# finding rather than a wrong one.
ANALYSIS_MAX_GAP_DAYS=5

# --- News providers (Milestone 2) ---------------------------------------------
# Ordered chain, and unlike MARKET_DATA_PROVIDERS every entry is queried rather
# than only the first that answers: two news sources carry different outlets,
# while two quote sources carry the same price. Overlap costs nothing because the
# pipeline deduplicates on url and content hash before doing any work. "fixture"
# reads data/fixtures/news.json and needs no network or API key, which is what CI
# and the offline demo run on. "gdelt" is real news, keyless (GDELT DOC 2.0,
# headlines only, one request per 5 s); a live installation sets
# NEWS_PROVIDERS=gdelt,fixture. Kept off here so CI and a fresh clone stay offline.
NEWS_PROVIDERS=fixture

# ---------------------------------------------------------------------------
# Corpus embeddings
# ---------------------------------------------------------------------------
# Which embedder turns concept documents into vectors for the search half of
# hybrid retrieval: fixture | openrouter.
#
# `fixture` is the default here and in code, and stays that way: it is
# deterministic, keyless and offline, so CI and a fresh clone embed the corpus
# with no account anywhere. It ranks by **shared words only** and has no
# semantic knowledge - "how much did I lose from the top" scores near zero
# against the drawdown document - and every search response says so with
# `vector_is_semantic: false`.
#
# `openrouter` is the real one, and needs OPENROUTER_API_KEY plus a workspace
# with budget. Measured over six paraphrased questions against the real corpus,
# it put the right concept in the top three 5/6 where the fixture managed 1/6.
# **Set this to `openrouter` in your own .env** if you have credit; the
# difference between the two is the difference between matching words and
# answering questions.
#
# Unlike LLM_PROVIDER, an unusable value here does NOT degrade - it stops the
# service starting and stops the ingester. There is no honest null embedding:
# retrieval that quietly ran on one of its two halves while still reporting
# scores and an ordering would be indistinguishable from retrieval that worked.
#
# Switching between them re-embeds on the next ingest and nothing else: the
# model is recorded per row, so `scripts/ingest_corpus.py` picks up every chunk
# the configured embedder did not write. Chunk ids do not move, so citations
# survive the change.
EMBEDDINGS_PROVIDER=fixture

# Only consulted when EMBEDDINGS_PROVIDER names a real provider. The default is
# the model `kb_chunks.embedding` was sized for - see migration 0013. Switching
# to text-embedding-3-large needs one line added in
# app/corpus/openrouter_embedder.py, because it is natively 3072 wide; without
# it, it fails on the first call rather than storing anything.
EMBEDDINGS_MODEL=openai/text-embedding-3-small
NEWSAPI_KEY=
SERPER_API_KEY=

# --- LLM provider factory (Milestone 2+) --------------------------------------
# Which adapter to use: openrouter | openai | ollama | null. A value that cannot
# work - an unknown name, a missing key, or `anthropic`, whose native API has no
# adapter yet - degrades to no narration and logs why, rather than failing the
# service at boot. Anthropic models are reachable through OpenRouter today.
LLM_PROVIDER=openrouter
# A `:free` suffix routes to OpenRouter's zero-cost pool and is priced at 0 by
# services/ai/app/llm/pricing.py - the gateway declares the price, so it is not
# guessed. Free routes are shared and answer 429 under load; a failed narration
# falls back to a template and says so. Any paid model id works here too.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TEMPERATURE=0.1
# Thinking budget for a reasoning model, sent only when non-empty. Reasoning is
# billed out of LLM_MAX_OUTPUT_TOKENS below, so an unbounded one can consume the
# whole cap and return an empty narration. "low" leaves room for the answer.
LLM_REASONING_EFFORT=low
# Hard daily spend ceiling in USD, enforced in code (services/ai/app/llm/budget.py)
# against estimated spend per UTC day. On breach the pipeline degrades to
# rule-based observations without LLM narration. 0 means no paid calls at all -
# unlike PROVIDER_DAILY_LIMITS above, it does not mean "unlimited".
LLM_DAILY_BUDGET_USD=5
# Per-call ceilings. A narration is a headline plus a short explanation, so a
# small output cap bounds both run latency and the cost of a verbose model.
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=30
# Token prices in USD per million tokens, "model=input/output", comma-separated,
# layered over the documented defaults in services/ai/app/llm/pricing.py. Spend is
# an ESTIMATE computed from this table: no OpenAI-compatible endpoint returns a
# billed amount, and OpenRouter charges its own rate per route. Override an entry
# when a vendor reprices; a release should not be needed for that.
# Example: LLM_MODEL_PRICES=anthropic/claude-sonnet-4.5=3/15,openai/gpt-4o-mini=0.15/0.60
LLM_MODEL_PRICES=
# Assumed price for a model absent from the table. Deliberately pessimistic: an
# unpriced model must not be counted as free, or the daily cap never fills.
LLM_UNKNOWN_MODEL_PRICE_USD_PER_MTOK=20

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# No adapter reads this yet; see LLM_PROVIDER above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama's root URL - the adapter appends the /v1 OpenAI-compatible prefix.
# host.docker.internal reaches the host's Ollama from inside a container; use
# http://localhost:11434 when running the service natively.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Local runtimes serve the models they have pulled, not the cloud model ids, so
# switching LLM_PROVIDER to ollama does not also mean editing LLM_MODEL.
OLLAMA_MODEL=llama3.2

# Embeddings are configured further up, under "Corpus embeddings". The M0
# placeholder that used to sit here named `fastembed` and a 384-wide model, and
# both are now wrong: no fastembed adapter was ever written, and the width is a
# property of the schema (`vector(1536)`, migration 0013) rather than a setting
# - an env var that cannot actually change the column would be a lie about what
# is configurable. If your own .env still carries these three lines, delete them
# and set EMBEDDINGS_PROVIDER to `fixture` or `openrouter`.

# --- Telegram (Milestone 4) ---------------------------------------------------
# Optional, and its absence is a supported state rather than a misconfiguration.
# With no token the fan-out still runs: findings are still routed, quiet hours
# still apply, and every message that could not be delivered is recorded in the
# `notifications` table with the reason. Check GET /notifications to see what
# the user would have been told - silence there means the scan found nothing,
# silence in the channel means nothing was configured, and the two are
# deliberately distinguishable.
TELEGRAM_BOT_TOKEN=
# The bot's @name, used only to build the t.me deep link behind "Connect".
TELEGRAM_BOT_USERNAME=
# Echoed by Telegram on every webhook delivery, and what signs the connect
# links. Both uses authenticate Telegram itself rather than a user.
TELEGRAM_WEBHOOK_SECRET=
# Signs the inline-button payloads. Deliberately NOT the same value as the
# webhook secret: that one is shared with Telegram and visible to anyone who can
# read the bot's configuration there, while this one never leaves the
# orchestrator. Sharing them would turn a leak of the value Telegram holds into
# the ability to forge approvals.
TELEGRAM_SIGNING_SECRET=
# How taps and commands reach the orchestrator: polling (default; pulls them
# with getUpdates, works with no public URL), webhook (once M7's ingress has
# registered one - Telegram refuses to serve both), or off (e.g. a second
# replica, since two pollers on one token steal each other's updates).
TELEGRAM_UPDATES=polling

# --- Observability ------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=traders
