# Non-secret settings for every Traders pod in a cluster, loaded into the
# ConfigMap `traders-config`. Secrets (passphrase, keys, the database password)
# are NOT here; they go in the Secret, generated per machine and never committed.
#
# The defaults are keyless on purpose: a stranger can run the cluster with no
# API key at all. Real prices come from Yahoo, which needs none; news,
# embeddings and narration use the fixture/template paths. The compose stack on
# the same machine keeps its own .env - the two share no database, no bot and no
# news downloads.

APP_ENV=development
LOG_LEVEL=info
BASE_CURRENCY=USD
APP_TIMEZONE=Asia/Jerusalem

# Service names inside the cluster, not host ports.
POSTGRES_USER=traders
POSTGRES_DB=traders
REDIS_URL=redis://redis:6379/0
AI_SERVICE_URL=http://ai-service:8000

# The address the browser uses: the Ingress (base/ingress.yaml). State-changing
# requests carrying any other Origin are refused.
ALLOWED_ORIGINS=http://traders.localhost

# Kubernetes CronJobs trigger runs; the in-process timer must stay off or both
# would fire (infra/k8s/README.md).
SCHEDULER_ENABLED=false

# Agents' scheduled scans run on the compose stack, not here (D71): the two
# cannot see each other's scans and bill the same model account.
ENABLE_SCHEDULED_SCANS=false
AGENT_SCAN_CONCURRENCY=4

# Telegram is off in the cluster: the bot configured on this machine belongs to
# the compose stack, and Telegram serves one consumer per token.
TELEGRAM_UPDATES=off

MARKET_DATA_PROVIDERS=yfinance
NEWS_PROVIDERS=fixture
EMBEDDINGS_PROVIDER=fixture
LLM_PROVIDER=none

# Where the AI image keeps its data (Dockerfile.ai).
CORPUS_DIR=/app/data/corpus
# The rescreen's snapshots, on the universe-snapshots claim (decision 90).
UNIVERSE_SNAPSHOT_DIR=/var/lib/traders/universe
FIXTURES_DIR=/app/data/fixtures
