# AI & analytics microservice.
# Build context is the repository root so `data/fixtures` and `data/corpus`
# can be copied in.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# curl is used by the container healthcheck; build tooling is not installed
# because every dependency ships wheels for this platform.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first, so editing source code does not reinstall the world.
COPY services/ai/pyproject.toml ./pyproject.toml
COPY services/ai/app/__init__.py ./app/__init__.py
RUN pip install --no-cache-dir . && pip install --no-cache-dir pytest pytest-asyncio ruff

COPY services/ai/app ./app
COPY services/ai/alembic ./alembic
COPY services/ai/alembic.ini ./alembic.ini
COPY services/ai/scripts ./scripts
COPY services/ai/tests ./tests
COPY data/fixtures /app/data/fixtures
# The concept corpus. `corpus_dir` in app/config.py resolves to this path
# when the repository checkout is not present, i.e. inside this image.
COPY data/corpus /app/data/corpus
# The /ask eval set (M3 slice 4). Beside the corpus on purpose: run_eval.py
# resolves it from CORPUS_DIR's parent, the same two-place resolution the
# corpus already uses, so the path is right in a checkout and in this image
# without a third guess. Without this line the CI eval step would fail with a
# missing file - which would at least be loud, unlike most path mistakes.
COPY data/eval /app/data/eval
# The instrument universe (M5): committed membership, facts and ETF holdings.
# Beside the corpus for the same two-place resolution (`ingest_universe.py`
# finds it from CORPUS_DIR's parent). Yahoo's descriptions are deliberately NOT
# in the image - they are licensed per installation, and an image is exactly
# the thing that gets pushed to a registry. `.dockerignore` excludes them, and
# compose mounts the checkout's copy into the one container that loads them.
COPY data/universe /app/data/universe

RUN pip install --no-cache-dir --no-deps -e .

# Run as a non-root user.
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
