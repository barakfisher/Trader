# Node/TypeScript orchestrator.
# Build context is the repository root (pnpm workspace).
FROM node:22-slim AS base

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NODE_ENV=production

WORKDIR /repo

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

# Manifests first for a cacheable dependency layer.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/orchestrator/package.json apps/orchestrator/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter @traders/orchestrator... --prod=false

COPY packages/shared packages/shared
COPY apps/orchestrator apps/orchestrator

WORKDIR /repo/apps/orchestrator

RUN useradd --create-home --uid 10002 appuser && chown -R appuser:appuser /repo
USER appuser

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:8080/healthz || exit 1

# The orchestrator runs its TypeScript directly through tsx: the service is
# started once per container, so a separate bundling step would add a build
# artifact to keep in sync for no runtime benefit. `pnpm typecheck` in CI is what
# guarantees the types.
CMD ["pnpm", "start"]
