# The database owner's password (D300): the role that runs migrations. Only the
# postgres and migrate containers load this file - every service connects as
# traders_app (APP_DB_PASSWORD in .env) - so a service cannot read the one
# credential that can change the schema. The start scripts copy this template on
# first run, or move the line from a .env written before the file existed.
#
# Postgres reads POSTGRES_PASSWORD only when it creates its data directory:
# editing it later locks migrate out (docs/RUNBOOK.md section 1). The URL names
# the same password; keep the two in step.
POSTGRES_PASSWORD=traders
MIGRATION_DATABASE_URL=postgresql://traders:traders@postgres:5432/traders
