{
  "name": "@traders/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node/TypeScript orchestrator: REST API, workflows, scheduling, HITL state, Telegram",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.2",
    "@mastra/core": "^1.67.0",
    "@mastra/pg": "^1.25.0",
    "@traders/shared": "workspace:*",
    "csv-parse": "^5.5.6",
    "hono": "^4.6.5",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
