{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/ingest-corpus-hook.sh\"",
            "timeout": 60,
            "statusMessage": "Re-ingesting the concept corpus"
          }
        ]
      }
    ]
  }
}
