{
  "name": "traders",
  "private": true,
  "version": "0.1.0",
  "description": "AI Financial Advisor & Portfolio Copilot - monorepo root",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:web": "pnpm --filter @traders/web dev",
    "dev:orchestrator": "pnpm --filter @traders/orchestrator dev",
    "up": "docker compose -f infra/compose/docker-compose.yml up --build",
    "down": "docker compose -f infra/compose/docker-compose.yml down -v",
    "logs": "docker compose -f infra/compose/docker-compose.yml logs -f",
    "gen:api": "pnpm --filter @traders/shared gen:api"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all"
  }
}
