# Secrets
.env
.env.*
!.env.example
!.env.owner.example

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local data
data/local/
*.local.json

# OS / editor
.DS_Store
.idea/

# Stray runtime databases from other tools
*.db

# Agent worktrees (temporary, created by parallel workers)
.claude/worktrees/

# Yahoo business summaries: fetched per installation, never committed (app/universe/snapshot.py)
data/universe/*.local.jsonl

# Kubernetes: per-machine secrets and the per-deploy kustomization (scripts/k8s-up.sh)
infra/k8s/overlays/*/secrets.env
infra/k8s/overlays/*/owner.env
infra/k8s/.deploy/

# Assistant eval reports: conversations with a real model, kept locally (scripts/run_assistant_eval.py)
services/ai/eval-results/
