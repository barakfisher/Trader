{
  "components": {
    "schemas": {
      "BackfillInstrument": {
        "properties": {
          "instrument_id": {
            "title": "Instrument Id",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "instrument_id",
          "symbol"
        ],
        "title": "BackfillInstrument",
        "type": "object"
      },
      "BackfillRequest": {
        "description": "Which instruments to fetch daily closes for, and how far back.",
        "properties": {
          "days": {
            "default": 180,
            "maximum": 3650.0,
            "minimum": 2.0,
            "title": "Days",
            "type": "integer"
          },
          "instruments": {
            "items": {
              "$ref": "#/components/schemas/BackfillInstrument"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Instruments",
            "type": "array"
          }
        },
        "required": [
          "instruments"
        ],
        "title": "BackfillRequest",
        "type": "object"
      },
      "BackfillResponse": {
        "properties": {
          "already_present": {
            "default": 0,
            "title": "Already Present",
            "type": "integer"
          },
          "per_symbol": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Per Symbol",
            "type": "object"
          },
          "without_history": {
            "description": "Symbols no provider could supply a series for. Reported rather than omitted: a holding the engine cannot analyse is something the user should be able to discover.",
            "items": {
              "type": "string"
            },
            "title": "Without History",
            "type": "array"
          },
          "written": {
            "default": 0,
            "title": "Written",
            "type": "integer"
          }
        },
        "title": "BackfillResponse",
        "type": "object"
      },
      "ConceptDocumentResponse": {
        "description": "A concept explainer, assembled from its chunks in stored order.\n\nServed whole rather than as a retrieval result: a chip names one concept\nexactly, so there is nothing to rank and no relevance floor to apply. The\nlicence and source travel with it because the corpus is required to be\nlicence-clean and a reader is entitled to know where an explanation came\nfrom.",
        "properties": {
          "license": {
            "title": "License",
            "type": "string"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/ConceptSection"
            },
            "title": "Sections",
            "type": "array"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uri"
          }
        },
        "required": [
          "slug",
          "title",
          "source",
          "uri",
          "license",
          "sections"
        ],
        "title": "ConceptDocumentResponse",
        "type": "object"
      },
      "ConceptSearchMatch": {
        "description": "One chunk a search returned, with where each half of the hybrid put it.\n\n`vector_rank` and `text_rank` are exposed rather than kept internal because\nthey are the only way a reader can tell which half found a result. A null\n`vector_rank` on every match means the corpus is not embedded and the answer\ncame from full-text alone - a real and recoverable state, and one that would\notherwise be indistinguishable from working hybrid retrieval.\n\n`document_id` and `chunk_id` are what a citation will point at when `/ask`\nlands, which is why the chunk id is here rather than only the slug.",
        "properties": {
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "concept_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concept Slug"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "ord": {
            "title": "Ord",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "text_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text Rank"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "vector_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vector Rank"
          }
        },
        "required": [
          "chunk_id",
          "document_id",
          "concept_slug",
          "title",
          "heading",
          "ord",
          "text",
          "score",
          "vector_rank",
          "text_rank"
        ],
        "title": "ConceptSearchMatch",
        "type": "object"
      },
      "ConceptSearchResponse": {
        "description": "A ranked answer, and an honest label for what produced the ranking.\n\n`vector_is_semantic` is False while the configured embedder ranks by word\noverlap alone, and it is on the wire rather than in a log because a caller\ncannot otherwise distinguish \"retrieval understood the question\" from\n\"retrieval matched some words\". Guideline 7 in its retrieval form: the thing\nthat is not available is reported as not available.\n\nThere is deliberately no relevance floor and no refusal here. Deciding that\nthe corpus does not cover a question is `/ask`'s judgement to make in slice\n3, and making it twice - once silently at this layer and once visibly there -\nwould mean a question could be refused by a threshold nobody chose.",
        "properties": {
          "embedding_model": {
            "title": "Embedding Model",
            "type": "string"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/ConceptSearchMatch"
            },
            "title": "Matches",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "vector_is_semantic": {
            "title": "Vector Is Semantic",
            "type": "boolean"
          }
        },
        "required": [
          "query",
          "matches",
          "embedding_model",
          "vector_is_semantic"
        ],
        "title": "ConceptSearchResponse",
        "type": "object"
      },
      "ConceptSection": {
        "description": "One `##` section of a concept document, as chunked at ingestion.\n\n`ord` is the position the ingester stored, so a citation can name a section\nrather than a byte range, and `id` is the chunk's own id - stable across\nre-ingestion of an unchanged document, which is what lets it be cited at all.",
        "properties": {
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "ord": {
            "title": "Ord",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ord",
          "heading",
          "text"
        ],
        "title": "ConceptSection",
        "type": "object"
      },
      "FxRate": {
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "base": {
            "title": "Base",
            "type": "string"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "rate": {
            "description": "Decimal as string to avoid float drift in transport.",
            "title": "Rate",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "base",
          "quote",
          "rate",
          "as_of",
          "source"
        ],
        "title": "FxRate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "service": {
            "default": "ai-service",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Instrument": {
        "properties": {
          "asset_class": {
            "default": "unknown",
            "enum": [
              "equity",
              "etf",
              "crypto",
              "fx",
              "index",
              "unknown"
            ],
            "title": "Asset Class",
            "type": "string"
          },
          "currency": {
            "default": "USD",
            "title": "Currency",
            "type": "string"
          },
          "exchange": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "source": {
            "default": "unknown",
            "title": "Source",
            "type": "string"
          },
          "symbol": {
            "description": "Canonical provider symbol, e.g. 'AAPL', 'BTC-USD'.",
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol"
        ],
        "title": "Instrument",
        "type": "object"
      },
      "InstrumentResolution": {
        "description": "Result of resolving a user-supplied string to a tradable instrument.\n\n`candidates` is non-empty and ordered by confidence whenever `resolved` is\nNone, so the UI can ask the user to disambiguate instead of guessing.",
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Instrument"
            },
            "title": "Candidates",
            "type": "array"
          },
          "confidence": {
            "default": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "resolved": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Instrument"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "query"
        ],
        "title": "InstrumentResolution",
        "type": "object"
      },
      "NarrationConfigResponse": {
        "description": "How narration is configured, for a UI that must not guess.\n\n`tier` is what a reader needs and the model id only implies: `free` is a\nroute that bills nothing and is served from a shared pool, `paid` bills per\ntoken, `none` means no provider was asked for at all. The last is a\nconfiguration rather than a failure, and the three are kept distinct so a UI\ncannot report \"deliberately off\" as \"broken\".",
        "properties": {
          "daily_budget_usd": {
            "title": "Daily Budget Usd",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "tier": {
            "enum": [
              "free",
              "paid",
              "none"
            ],
            "title": "Tier",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "tier",
          "daily_budget_usd"
        ],
        "title": "NarrationConfigResponse",
        "type": "object"
      },
      "ObservationOut": {
        "description": "A finding, its words, and its identity.\n\n`evidence` carries every figure the headline and explanation rest on; the\nnarration validator rejects any that is not here. `narration_source` says who\nwrote the words, and `fallback_reason` why the model did not, so the\nrejection rate is measurable.",
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "concept_refs": {
            "items": {
              "type": "string"
            },
            "title": "Concept Refs",
            "type": "array"
          },
          "dedupe_key": {
            "title": "Dedupe Key",
            "type": "string"
          },
          "evidence": {
            "additionalProperties": true,
            "title": "Evidence",
            "type": "object"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "fallback_reason": {
            "default": "none",
            "title": "Fallback Reason",
            "type": "string"
          },
          "headline": {
            "title": "Headline",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "narration_source": {
            "enum": [
              "llm",
              "template"
            ],
            "title": "Narration Source",
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "notable",
              "high"
            ],
            "title": "Severity",
            "type": "string"
          },
          "subject_ref": {
            "title": "Subject Ref",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "severity",
          "subject_ref",
          "as_of",
          "headline",
          "explanation",
          "dedupe_key",
          "narration_source"
        ],
        "title": "ObservationOut",
        "type": "object"
      },
      "PortfolioScanRequest": {
        "properties": {
          "base_currency": {
            "default": "USD",
            "title": "Base Currency",
            "type": "string"
          },
          "holdings": {
            "items": {
              "$ref": "#/components/schemas/ScanHolding"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Holdings",
            "type": "array"
          },
          "known_dedupe_keys": {
            "description": "Dedupe keys the caller has already stored. Matching findings are counted and skipped before narration, so a repeat costs a hash rather than a model call. Omit to narrate everything.",
            "items": {
              "type": "string"
            },
            "maxItems": 5000,
            "title": "Known Dedupe Keys",
            "type": "array"
          },
          "target_weights": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "symbol -> target weight as a decimal string, e.g. {'VOO': '0.25'}.",
            "title": "Target Weights",
            "type": "object"
          }
        },
        "required": [
          "holdings"
        ],
        "title": "PortfolioScanRequest",
        "type": "object"
      },
      "PortfolioScanResponse": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ObservationOut"
            },
            "title": "Observations",
            "type": "array"
          },
          "stats": {
            "$ref": "#/components/schemas/ScanStatsOut"
          }
        },
        "required": [
          "observations",
          "stats"
        ],
        "title": "PortfolioScanResponse",
        "type": "object"
      },
      "Quote": {
        "description": "A single price observation. `price_minor` is integer minor units.",
        "properties": {
          "as_of": {
            "description": "When this price was observed, not when it was fetched. Providers that publish a trade timestamp supply it directly; for the rest it is the fetch time floored to the provider's freshness window, so repeated reads of one observation share an as_of and deduplicate on storage.",
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "day_change_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day Change Pct"
          },
          "delay_seconds": {
            "default": 0,
            "description": "Provider-declared quote delay. Displayed in the UI; 0 means real time.",
            "title": "Delay Seconds",
            "type": "integer"
          },
          "previous_close_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Close Minor"
          },
          "price_minor": {
            "title": "Price Minor",
            "type": "integer"
          },
          "source": {
            "description": "Provider that produced this quote, e.g. 'fixture', 'yfinance'.",
            "title": "Source",
            "type": "string"
          },
          "stale": {
            "default": false,
            "description": "True when served from cache after every live provider failed.",
            "title": "Stale",
            "type": "boolean"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "price_minor",
          "currency",
          "as_of",
          "source"
        ],
        "title": "Quote",
        "type": "object"
      },
      "QuoteRequest": {
        "properties": {
          "symbols": {
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Symbols",
            "type": "array"
          }
        },
        "required": [
          "symbols"
        ],
        "title": "QuoteRequest",
        "type": "object"
      },
      "QuoteResponse": {
        "properties": {
          "missing": {
            "description": "Symbols no provider in the chain could price.",
            "items": {
              "type": "string"
            },
            "title": "Missing",
            "type": "array"
          },
          "quotes": {
            "items": {
              "$ref": "#/components/schemas/Quote"
            },
            "title": "Quotes",
            "type": "array"
          }
        },
        "required": [
          "quotes"
        ],
        "title": "QuoteResponse",
        "type": "object"
      },
      "ScanHolding": {
        "description": "One holding as the scan needs it.\n\n`value_minor` is the holding's market value in the portfolio's base currency,\ncomputed by the orchestrator, which owns valuation and the FX rates. It is\nnull when the holding could not be priced - carried rather than omitted so\nthe scan can report that allocation drift was skipped, and why.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the price behind value_minor was observed. Allocation drift dates a weight by the stalest price contributing to it, so a position without this cannot take part.",
            "title": "As Of"
          },
          "currency": {
            "default": "USD",
            "title": "Currency",
            "type": "string"
          },
          "instrument_id": {
            "title": "Instrument Id",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "value_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Minor"
          }
        },
        "required": [
          "instrument_id",
          "symbol"
        ],
        "title": "ScanHolding",
        "type": "object"
      },
      "ScanStatsOut": {
        "properties": {
          "already_known": {
            "default": 0,
            "title": "Already Known",
            "type": "integer"
          },
          "drift_skipped_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drift Skipped Reason"
          },
          "findings": {
            "default": 0,
            "title": "Findings",
            "type": "integer"
          },
          "insufficient_history": {
            "items": {
              "type": "string"
            },
            "title": "Insufficient History",
            "type": "array"
          },
          "narrated_by_llm": {
            "default": 0,
            "title": "Narrated By Llm",
            "type": "integer"
          },
          "narration_fallbacks": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Narration Fallbacks",
            "type": "object"
          },
          "subjects": {
            "default": 0,
            "title": "Subjects",
            "type": "integer"
          },
          "subjects_with_history": {
            "default": 0,
            "title": "Subjects With History",
            "type": "integer"
          }
        },
        "title": "ScanStatsOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Market data, analysis pipeline and RAG engine for the portfolio copilot.",
    "title": "Traders AI Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/analysis/portfolio-scan": {
      "post": {
        "operationId": "portfolio_scan_analysis_portfolio_scan_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-internal-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortfolioScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioScanResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Portfolio Scan",
        "tags": [
          "analysis"
        ]
      }
    },
    "/concepts": {
      "get": {
        "description": "Every concept the corpus can answer for.",
