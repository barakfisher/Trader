    "/concepts/search": {
      "get": {
        "description": "Hybrid retrieval over the corpus: the half of `/ask` that finds things.\n\n**Declared before `/concepts/{slug}`, and that is load-bearing.** FastAPI\nmatches routes in registration order, so a path parameter registered first\nwould swallow `/concepts/search` as a request for a concept called \"search\" -\nwhich fails as a 404 naming a slug nobody asked for, and reads as a missing\ncorpus rather than as a shadowed route.\n\nThis exists in slice 2, before `/ask` in slice 3, on purpose. The hermetic\nPython suite has no Postgres and therefore cannot execute a line of the SQL\nunderneath this - the same blind spot that shipped a namespace bug in slice 1\n- so the retrieval path needs a way to be exercised by hand against a real\ndatabase *before* something else is built on top of it. It is a diagnostic\nsurface, not a product feature: no relevance floor, no refusal, no intent\nrouting. Those are judgements `/ask` makes, and making them here as well\nwould put them in two places at once.",
        "operationId": "search_concepts_concepts_search_get",
        "parameters": [
          {
            "description": "A question or phrase to search the corpus for",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "A question or phrase to search the corpus for",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-internal-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Concepts",
        "tags": [
          "concepts"
        ]
      }
    },
